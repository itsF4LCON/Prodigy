<?xml version="1.0" encoding="utf-8"?>
<!-- Fake GDK package manifest for the Prodigy test title. -->
<Game configVersion="1">
  <Identity Name="Prodigy.TestTitle" Publisher="CN=Prodigy" Version="1.0.0.0"/>
  <ExecutableList>
    <Executable Name="prodigy_testtitle.exe" TargetDeviceFamily="Scarlett" Id="Game"/>
  </ExecutableList>
  <ShellVisuals DefaultDisplayName="Prodigy Test Title" PublisherDisplayName="Prodigy"/>
  <!-- settings Prodigy takes from a title's manifest (values of a real title) -->
  <PersistentLocalStorage>
    <SizeMB>2048</SizeMB>
  </PersistentLocalStorage>
  <VirtualMachine>
    <SMTEnabled>true</SMTEnabled>
    <XboxLockhartTitleMemory>Advanced</XboxLockhartTitleMemory>
    <XboxAnacondaTitleMemory>Advanced</XboxAnacondaTitleMemory>
  </VirtualMachine>
</Game>
